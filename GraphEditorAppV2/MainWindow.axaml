<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:pages="using:GraphEditorAppV2"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GraphEditorAppV2.MainWindow"
        Title="GraphEditorAppV2"
		x:Name="MainAppWindow">

		<!--<Window.KeyBindings>
			<KeyBinding Gesture="F3" Command="{Binding MyCommand}" />
		</Window.KeyBindings>-->


		<SplitView PanePlacement="Right" IsPaneOpen="False" DisplayMode="CompactOverlay" CompactPaneLength="20">

		<!-- full-viewport grid panel. If no row/column specified, then each child is a full size layer -->
		<Grid>
			<!-- full-viewport skia panel  -->
			<pages:CustomSkiaPage Name="SkiaView" />
			
			<!-- full-viewport DockPanel, used to dock menu at top, log area at bottom -->
			<DockPanel>
				<Menu DockPanel.Dock="Top">
					<MenuItem Header="_File">
						<MenuItem Header="_New" Click="New_OnClick" />
						<Separator/>
						<MenuItem Header="_Open..." Click="Open_OnClick" />
						<MenuItem Header="_Import..." Click="Import_OnClick" />
						<MenuItem Header="_Save" Click="Save_OnClick"/>
						<MenuItem Header="_Save As..." Click="SaveAs_OnClick"/>
						<Separator/>
						<MenuItem Header="Recent Files..." Name="RecentFilesMenu"/>
						<MenuItem Header="Open Current Folder" Click="OpenCurrentFolder_OnClick"/>
						<Separator/>
						<MenuItem Header="_Exit" Click="Exit_OnClick"/>
					</MenuItem>
					<MenuItem Header="_Edit">
						<MenuItem Header="_Copy" Click="Copy_OnClick" />
						<MenuItem Header="_Paste" Click="Paste_OnClick" />
						<Separator/>
						<MenuItem Header="_New Function" Click="NewFunction_OnClick" />
						<Separator/>
						<MenuItem Header="_Generate Code" Click="GenerateCode_OnClick" />
					</MenuItem>
					<MenuItem Header="Settings">
						<CheckBox Name="Option_LoadLastOnStartup" Click="LoadLastOnStartup_OnToggle">Load Last Graph On Startup</CheckBox>
						<Separator/>
						<CheckBox Name="Option_EnableGraphDebug" Click="GraphDebugging_OnToggle">Enable Graph Debug</CheckBox>
					</MenuItem>
				</Menu>

				<Border DockPanel.Dock="Bottom" Background="#CCCCCC" BorderBrush="Black" BorderThickness="2" Margin="0" Height="150">
					<DockPanel Margin="5">
						<Panel Margin="3" DockPanel.Dock="Top">
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="5">
								<Button Content="Output" Padding="5,0" Focusable="False" Click="SetLogFilter_Output" />
								<Button Content="Log" Padding="5,0" Focusable="False" Click="SetLogFilter_All" />
							</StackPanel>
							<Button HorizontalAlignment="Right" Content="Clear" Padding="5,0" Focusable="False" Click="ClearLog_OnClick" />
						</Panel>

						<Border Background="#888888">
							<ScrollViewer Name="LogTextAreaScrollView">
								<SelectableTextBlock Name="LogTextArea" Margin="3">
									Welcome to Derivative Graph Editor!
								</SelectableTextBlock>
							</ScrollViewer>
						</Border>
					</DockPanel>
				</Border>

				<Panel/> <!-- last item in DockPanel fills the rest of the space... -->
			</DockPanel>
			
			<!--- temporary... -->
			<Canvas Name="MyCanvas">
				<Button Name="myButton" Content="Movable Button"/>
			</Canvas>
			
		</Grid>

		<!--- rhs panel, no content yet -->
		<SplitView.Pane>
			[
		</SplitView.Pane>
				
			
		</SplitView>

	</Window>
